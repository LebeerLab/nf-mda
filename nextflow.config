docker {
  enabled = true


}
params {
  formulas = "data/mda.example.formulas.txt"
  count_matrix = "data/mda.example.count_data.tsv"
  metadata = "data/mda.example.meta_data.tsv"

  params.outdir = "results"

  skip_lmclr = false
  skip_maaslin3 = false
  skip_maaslin2 = true
  skip_deseq2 = false
  skip_aldex3 = false
  skip_aldex2 = true
  skip_limma = false
  skip_corncob = true
  skip_ancombc2 = false
  skip_zicoseq = true
}
